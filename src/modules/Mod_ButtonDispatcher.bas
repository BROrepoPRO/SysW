' Btn_main_RunTests_Click
' Запускает все тесты (TC-01..TC-20)
' --------------------------------------------------------------------------
Public Sub Btn_main_RunTests_Click()
    Call Mod_FullTestRunner.RunAllTests_UI
End Sub

' --------------------------------------------------------------------------
' Btn_main_WriteLog_Click
' Записывает сообщение в лог-файл через диалог ввода
